name = "c0ld-clan-api"
main = "c0ld-clan-api-worker.js"
compatibility_date = "2026-06-16"

[triggers]
crons = ["*/5 * * * *", "* * * * *"]

[vars]
CLAN_NAME = "c0ld"
# Scheduled member snapshots power both mascot-selectable clan modes.
CLAN_NAMES = "c0ld,WMSY"
WMSY_MODE_ENABLED = "true"
CURRENT_BATTLE_NAME = "auto"
AUTO_DETECT_BATTLE = "true"
ACTIVE_BATTLE_LOOKUP = "true"
SKIP_ENDED_BATTLE_INGEST = "true"
BATTLE_INGEST_FINAL_PULL_GRACE_MINUTES = "0"
# Optional overrides. Leave blank to use API metadata when present.
CURRENT_BATTLE_DISPLAY_NAME = ""
CURRENT_BATTLE_END_ISO = ""
SITE_ORIGINS = "https://oapl.github.io,https://c0ld-clan.com,https://www.c0ld-clan.com"
PUBLIC_CACHE_SECONDS = "30"
CURRENT_CACHE_SECONDS = "60"
CLANS_CURRENT_CACHE_SECONDS = "60"
GLOBAL_CURRENT_CACHE_SECONDS = "120"
GLOBAL_LEADERBOARD_FAST_CACHE_SECONDS = "120"
GLOBAL_LEADERBOARD_CACHE_SECONDS = "300"
# auto = active Clan Battle crawl when one exists; otherwise live League Top 500.
# Set to "clans" or "leagues" only to force a source during testing.
GLOBAL_LEADERBOARD_SOURCE = "auto"
# Optional. Leave blank/omit to keep archived battle snapshots indefinitely.
# Set to a positive hour count only if you intentionally want rolling pruning.
SNAPSHOT_RETENTION_HOURS = ""
# Optional safety cap for /api/history and /api/clans/history requests.
HISTORY_MAX_HOURS = "100000"
ROBLOX_USERNAME_LOOKUPS = "true"
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
MEMBER_SNAPSHOT_MIN_INTERVAL_MINUTES = "5"
INGEST_HOURLY_ASSIGNMENT_CLANS = "true"
HOURLY_ASSIGNMENT_CLAN_SCHEDULE_MINUTES = "15"
HOURLY_ASSIGNMENT_CLAN_SCHEDULE_OFFSET_MINUTES = "0"
HOURLY_ASSIGNMENT_CLAN_SCAN_LIMIT = "50"
INGEST_CLANS_LEADERBOARD = "true"
CLAN_RANK_TOP_N = "200"
CLANS_SNAPSHOT_MIN_INTERVAL_MINUTES = "5"
CLAN_BATTLES_SCAN_LIMIT = "20000"
# Optional global player rank cache for /api/global/current and /api/global/search.
# This stays off unless explicitly enabled. It scans ranked clans in controlled
# chunks, stores candidate player contribution rows, then ranks every unique
# player found inside the configured clan scan limit.
INGEST_GLOBAL_RANKS = "false"
GLOBAL_RANK_SCHEDULE_MINUTES = "30"
GLOBAL_RANK_SCHEDULE_OFFSET_MINUTES = "0"
GLOBAL_RANK_CLAN_SCAN_LIMIT = "500"
GLOBAL_RANK_CLAN_PAGE_SIZE = "100"
GLOBAL_RANK_CLANS_PER_RUN = "50"
# Ten 50-clan shards complete Top 500 in one Worker invocation. Candidate
# writes are batched so this does not require one Supabase request per clan.
GLOBAL_RANK_SHARD_COUNT = "10"
GLOBAL_RANK_SHARD_CONCURRENCY = "10"
GLOBAL_RANK_CLANS_PER_SHARD_RUN = "50"
GLOBAL_RANK_CANDIDATE_CLAN_BATCH_SIZE = "10"
GLOBAL_RANK_CLAN_DELAY_MS = "750"
GLOBAL_RANK_RETRY_ATTEMPTS = "6"
GLOBAL_RANK_RETRY_BASE_MS = "15000"
GLOBAL_RANK_NAME_SCAN_LIMIT = "50000"
GLOBAL_RANK_RETENTION_ENABLED = "false"
GLOBAL_RANK_RETENTION_HOURS = "24"
GLOBAL_RANK_RETENTION_DELETE_RUNS_PER_PASS = "3"
DERIVED_SNAPSHOT_CACHE_SECONDS = "3600"
GLOBAL_RANK_EVENT_NAME = ""
GLOBAL_RANK_LEADERBOARD_LABEL = ""
PS99_UPDATE_LABEL = ""
PS99_UPDATE_NUMBER = ""
# Optional reward cutoff ranks returned by /api/reward-cutoffs when no ranks
# query parameter is provided.
PLAYER_REWARD_CUTOFF_RANKS = "3,10,100,250,500,1000,10000"
CLAN_REWARD_CUTOFF_RANKS = "1,3,10,30,50,250,500"
LEAGUE_API_BASE = "https://yamo-league-api-worker.opal-dde.workers.dev"
LEAGUE_REWARD_CUTOFF_RANKS = "1,3,15,50,100,250,2000"
REWARD_CUTOFFS_SCHEDULE_MINUTES = "5"
REWARD_CUTOFFS_SCHEDULE_OFFSET_MINUTES = "0"
# Optional top-clan roster activity tracking for clans-activity.html and activity-feed.html.
INGEST_CLAN_ACTIVITY = "false"
CLAN_ACTIVITY_TOP_N = "100"
CLAN_ACTIVITY_CONCURRENCY = "8"
CLAN_ACTIVITY_SCHEDULE_MINUTES = "30"
CLAN_ACTIVITY_SCHEDULE_OFFSET_MINUTES = "0"
CLAN_ACTIVITY_MIN_SNAPSHOT_INTERVAL_MINUTES = "25"
CLAN_ACTIVITY_CLAN_DELAY_MS = "250"
# Optional Discord no-gain/offline pings managed by /offline commands.
INGEST_OFFLINE_ALERTS = "false"
OFFLINE_DEFAULT_MINUTES = "30"
OFFLINE_DEFAULT_POST_RATE_MINUTES = "30"
OFFLINE_ALERT_SCHEDULE_MINUTES = "5"
OFFLINE_ALERT_SCHEDULE_OFFSET_MINUTES = "0"
OFFLINE_LOOKBACK_BUFFER_MINUTES = "30"
# Optional PS99 place version catalog for ps99-version-history.html.
INGEST_PS99_VERSION_HISTORY = "true"
PS99_UNIVERSE_ID = "3317771874"
PS99_ROOT_PLACE_ID = "8737899170"
PS99_REFRESH_PLACE_LIST = "true"
PS99_VERSION_SCHEDULE_MINUTES = "5"
PS99_VERSION_SCHEDULE_OFFSET_MINUTES = "0"
PS99_VERSION_PLACE_DELAY_MS = "0"
PS99_VERSION_HISTORY_CACHE_SECONDS = "60"
INGEST_ROBLOX_RELEASE_VERSION_HISTORY = "true"
ROBLOX_RELEASE_BINARY_TYPE = "WindowsPlayer"
ROBLOX_RELEASE_CHANNEL = "live"
ROBLOX_RELEASE_SCHEDULE_MINUTES = "5"
ROBLOX_RELEASE_SCHEDULE_OFFSET_MINUTES = "0"
ROBLOX_RELEASE_VERSION_HISTORY_CACHE_SECONDS = "60"
INGEST_ROBLOX_FFLAGS = "true"
ROBLOX_FFLAGS_SOURCE_URL = "https://clientsettings.roblox.com/v2/settings/application/PCDesktopClient/channel/live"
ROBLOX_FFLAGS_SCOPE_KEY = "pc-live"
ROBLOX_FFLAG_SCHEDULE_MINUTES = "15"
ROBLOX_FFLAG_SCHEDULE_OFFSET_MINUTES = "0"
ROBLOX_FFLAGS_CACHE_SECONDS = "60"
INGEST_PS99_DEV_BLOGS = "true"
PS99_DEV_BLOG_FEED_URL = "https://www.biggames.io/post"
PS99_DEV_BLOG_SCHEDULE_MINUTES = "15"
PS99_DEV_BLOG_SCHEDULE_OFFSET_MINUTES = "0"
PS99_DEV_BLOGS_CACHE_SECONDS = "60"
INGEST_PS99_RESTARTS = "true"
# sentinel (default) means public server-list turnover can never create an
# alert. Use legacy only if you intentionally want the old API-only detector.
PS99_RESTART_CONFIRMATION_MODE = "sentinel"
PS99_RESTART_SENTINEL_ENABLED = "true"
PS99_RESTART_PROBE_QUORUM = "3"
PS99_RESTART_PROBE_SAME_VERSION_QUORUM = "4"
PS99_RESTART_PROBE_MACHINE_QUORUM = "2"
PS99_RESTART_PROBE_WINDOW_SECONDS = "600"
PS99_RESTART_PROBE_STALE_SECONDS = "120"
PS99_RESTART_PROBE_HISTORY_SECONDS = "1800"
PS99_RESTART_BATCH_SIZE = "100"
PS99_RESTART_PAGE_COUNT = "5"
PS99_RESTART_SAMPLE_SIZE = "10"
PS99_RESTART_RECENT_VERSION_WINDOW_MINUTES = "60"
PS99_RESTART_INTEL_TURNOVER_PERCENT = "50"
PS99_RESTART_CONFIRMATIONS = "2"
PS99_RESTART_REQUIRE_VERSION_CORRELATION = "true"
PS99_RESTART_COOLDOWN_MINUTES = "10"
PS99_RESTART_CACHE_SECONDS = "30"
# Optional per-channel role mentions. Roblox updates and PS99 restarts default
# to the shared detector alert role when blank.
ROBLOX_UPDATES_ROLE_ID = ""
PS99_UPDATES_ROLE_ID = ""
PS99_FFLAGS_ROLE_ID = ""
PS99_RESTARTS_ROLE_ID = ""
PS99_DEV_BLOG_ROLE_ID = ""
REWARD_CUTOFFS_ROLE_ID = ""
CW_BOT_IMPORT_PREVENT_OVERWRITE = "true"
BIG_BOT_IMPORT_PREVENT_OVERWRITE = "true"

# Set these with `wrangler secret put ...`
# SUPABASE_SERVICE_KEY
# INGEST_ADMIN_TOKEN
# PS99_RESTART_PROBE_TOKEN
# ROBLOX_UPDATES_WEBHOOK_URL
# ROBLOX_UPDATES_ROLE_ID (defaults in code to 1529578783131177131)
# PS99_UPDATES_WEBHOOK_URL
# PS99_FFLAGS_WEBHOOK_URL
# PS99_RESTARTS_WEBHOOK_URL
# PS99_RESTARTS_ROLE_ID (defaults in code to 1529578783131177131)
# PS99_DEV_BLOG_WEBHOOK_URL
# REWARD_CUTOFFS_WEBHOOK_URL
# PS99_ALERT_WEBHOOK_URL (legacy fallback for PS99 updates and restarts)
