name = "c0ld-clan-api"
main = "c0ld-clan-api-worker.js"
compatibility_date = "2026-06-16"

[triggers]
crons = ["*/5 * * * *"]

[vars]
CLAN_NAME = "c0ld"
CURRENT_BATTLE_NAME = "auto"
AUTO_DETECT_BATTLE = "true"
ACTIVE_BATTLE_LOOKUP = "true"
SKIP_ENDED_BATTLE_INGEST = "true"
# Optional overrides. Leave blank to use API metadata when present.
CURRENT_BATTLE_DISPLAY_NAME = ""
CURRENT_BATTLE_END_ISO = ""
SITE_ORIGINS = "https://oapl.github.io"
PUBLIC_CACHE_SECONDS = "30"
# Optional. Leave blank/omit to keep archived battle snapshots indefinitely.
# Set to a positive hour count only if you intentionally want rolling pruning.
SNAPSHOT_RETENTION_HOURS = ""
# Optional safety cap for /api/history and /api/clans/history requests.
HISTORY_MAX_HOURS = "100000"
ROBLOX_USERNAME_LOOKUPS = "true"
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
INGEST_CLANS_LEADERBOARD = "true"
CLAN_RANK_TOP_N = "200"
CLAN_BATTLES_SCAN_LIMIT = "20000"
# Optional global player rank cache for /api/global/current and /api/global/search.
# This stays off unless explicitly enabled. It scans ranked clans in controlled
# chunks, stores candidate player contribution rows, then ranks every unique
# player found inside the configured clan scan limit.
INGEST_GLOBAL_RANKS = "false"
GLOBAL_RANK_SCHEDULE_MINUTES = "60"
GLOBAL_RANK_SCHEDULE_OFFSET_MINUTES = "0"
GLOBAL_RANK_CLAN_SCAN_LIMIT = "500"
GLOBAL_RANK_CLAN_PAGE_SIZE = "100"
GLOBAL_RANK_CLANS_PER_RUN = "25"
GLOBAL_RANK_CLAN_DELAY_MS = "1000"
GLOBAL_RANK_RETRY_ATTEMPTS = "6"
GLOBAL_RANK_RETRY_BASE_MS = "15000"
GLOBAL_RANK_EVENT_NAME = ""

# Set these with `wrangler secret put ...`
# SUPABASE_SERVICE_KEY
# INGEST_ADMIN_TOKEN
