name = "inventory-detector-worker"
main = "inventory-detector-worker.js"
compatibility_date = "2026-07-17"

[vars]
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
INVENTORY_USERS_JSON = '[{"user_id":"109818","username":"Cinnamowopal"},{"user_id":"463900811","username":"AgentP_0928"}]'
INVENTORY_TIME_ZONE = "America/Denver"
INVENTORY_MIN_FETCH_INTERVAL_MINUTES = "55"
INVENTORY_SKIP_DUPLICATE_SOURCE = "true"
INVENTORY_REJECT_EMPTY = "true"
INVENTORY_LEAGUE_FEATURE = "true"
INVENTORY_AUTO_DISCOVER_MEMBERS = "true"
INVENTORY_SYNC_COHORT = "true"
LEAGUE_API_BASE = "https://yamo-league-api-worker.YOUR-SUBDOMAIN.workers.dev"
BIG_GAMES_CLIENT_ID = "bgapp_REPLACE_ME"
BIG_GAMES_REDIRECT_URI = "https://inventory-detector-worker.YOUR-SUBDOMAIN.workers.dev/api/inventory/oauth/callback"
HATCH_BIG_GAMES_CLIENT_ID = "bgapp_REPLACE_WITH_LUNA_HTG_APP"
HATCH_BIG_GAMES_REDIRECT_URI = "https://inventory-detector-worker.YOUR-SUBDOMAIN.workers.dev/api/inventory/oauth/callback"
# HTG defaults to these four scopes so source filtering can distinguish hatches
# from trade, booth, or mail gains. Register them on the Luna HTG Big Games app.
# Existing grants must reauthorize after changing app credentials or scopes.
# HATCH_BIG_GAMES_SCOPES = "player-data:pet-simulator-99:inventory:read player-data:pet-simulator-99:trades:read player-data:pet-simulator-99:booth:read player-data:pet-simulator-99:mail:read"
HATCH_SOURCE_FILTER_ENABLED = "true"
INVENTORY_OAUTH_RETURN_URL = "https://c0ld-clan.com/league-inv-test.html"
# HTG is Discord-bot only. Leave this blank unless you build a dedicated HTG return page.
HATCH_TRACKER_RETURN_URL = ""
# Legacy fallback only. Prefer `/htg assign channel:<channel>` after deploying
# the Discord command worker and applying migration 036.
HATCH_ALERT_CHANNEL_ID = ""
PUBLIC_CACHE_SECONDS = "5"
ALLOWED_ORIGIN = "https://c0ld-clan.com"

# One scheduled collection per hour for every configured or actively opted-in
# account. OAuth callback tests that request refresh=true are counted separately.
[triggers]
crons = ["17 * * * *"]

# Required secrets:
# wrangler secret put SUPABASE_SERVICE_KEY
# wrangler secret put INGEST_ADMIN_TOKEN
# wrangler secret put BIG_GAMES_CLIENT_SECRET
# wrangler secret put HATCH_BIG_GAMES_CLIENT_SECRET
#
# Optional:
# wrangler secret put DISCORD_WEBHOOK_URL
# wrangler secret put DISCORD_BOT_TOKEN
# wrangler secret put HATCH_ALERT_WEBHOOK_URL
# wrangler secret put INVENTORY_TOKEN_ENCRYPTION_SECRET
