name = "inventory-detector-worker"
main = "inventory-detector-worker.js"
compatibility_date = "2026-07-17"

[vars]
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
INVENTORY_USERS_JSON = '[{"user_id":"109818","username":"Cinnamowopal"},{"user_id":"463900811","username":"AgentP_0928"}]'
INVENTORY_TIME_ZONE = "America/Denver"
INVENTORY_MIN_FETCH_INTERVAL_MINUTES = "55"
INVENTORY_SKIP_DUPLICATE_SOURCE = "true"
INVENTORY_REJECT_EMPTY = "true"
INVENTORY_LEAGUE_FEATURE = "true"
INVENTORY_AUTO_DISCOVER_MEMBERS = "true"
INVENTORY_SYNC_COHORT = "true"
LEAGUE_API_BASE = "https://yamo-league-api-worker.YOUR-SUBDOMAIN.workers.dev"
BIG_GAMES_CLIENT_ID = "bgapp_REPLACE_ME"
BIG_GAMES_REDIRECT_URI = "https://inventory-detector-worker.YOUR-SUBDOMAIN.workers.dev/api/inventory/oauth/callback"
HATCH_BIG_GAMES_CLIENT_ID = "bgapp_REPLACE_WITH_LUNA_HTG_APP"
HATCH_BIG_GAMES_REDIRECT_URI = "https://inventory-detector-worker.YOUR-SUBDOMAIN.workers.dev/cb"
HATCH_OAUTH_PUBLIC_BASE = "https://inventory-detector-worker.YOUR-SUBDOMAIN.workers.dev"
# HTG defaults to these four scopes so source filtering can distinguish tracked
# HTG inventory gains from trade, booth, or mail gains. Register them on the Luna
# HTG Big Games app.
# Existing grants must reauthorize after changing app credentials or scopes.
# HATCH_BIG_GAMES_SCOPES = "player-data:pet-simulator-99:inventory:read player-data:pet-simulator-99:trades:read player-data:pet-simulator-99:booth:read player-data:pet-simulator-99:mail:read"
HTG_SCAN_INTERVAL_MINUTES = "15"
# Each account receives one stable minute within each 15-minute window. This
# spreads community scans over the window instead of bursting every account at
# :00/:15/:30/:45, while keeping a predictable quota-safe cadence.
HTG_SCHEDULE_ALIGNMENT_MINUTES = "15"
HTG_SHARD_COUNT = "15"
# Diagnostic only. Do not set this in production: it sends every account at
# the same minute and can trip BIG Games' per-key minute limit.
# HTG_DISABLE_SCHEDULE_STAGGER = "false"
HTG_MAX_CONCURRENT_SCANS = "3"
HTG_REFRESH_QUOTA_LIMIT = "48"
HTG_REFRESH_QUOTA_RESERVE = "6"
# Legacy retry/backfill variables remain accepted for existing deployments, but
# HTG v2 deliberately uses the normal quota-safe cadence after a failed scan.
# It never applies exponential failure backoff to an account.
HTG_FAILURE_RETRY_MINUTES = "15"
HTG_FAILURE_RETRY_MAX_MINUTES = "120"
HTG_REQUIRE_SOURCE_FILTER = "true"
# HTG v2 always requires exactly one later fresh inventory revision before
# posting an unmatched gain. This legacy variable no longer changes that.
HTG_SOURCE_CONFIRMATION_OBSERVATIONS = "2"
HTG_SCAN_HISTORY_LIMIT = "96"
# Diagnostic age threshold for a pending gain whose trade/booth/mail source
# verification is unavailable. The gain remains pending and is retried; it is
# not silently absorbed into the baseline.
HTG_SOURCE_FILTER_HOLD_MINUTES = "20"
# If a tracker was not checked within this window, HTG advances the compact
# baseline without posting delayed gains all at once.
HTG_STALE_ALERT_WINDOW_MINUTES = "30"
# Default false. Leave false so a fresh inventory received after an outage is
# source-filtered and alerted instead of silently absorbed into the baseline.
HTG_DROP_STALE_GAINS = "false"
# HTG uses `refresh=true` by default at its quota-safe schedule so every alert
# comparison is against a new provider inventory revision. Do not add this
# variable in production unless you are deliberately diagnosing cached reads.
# HTG_DISABLE_FORCED_REFRESH = "false"
HATCH_SOURCE_FILTER_ENABLED = "true"
HATCH_BASELINE_PROTECTION_ENABLED = "true"
HATCH_BASELINE_STABLE_COMPARISONS = "1"
HATCH_BACKFILL_MIN_ITEM_GROWTH = "25"
HATCH_BACKFILL_ITEM_GROWTH_RATIO = "0.05"
HATCH_BACKFILL_HTG_GAIN_COUNT = "2"
HATCH_BACKFILL_TOTAL_GAIN_COUNT = "20"
INVENTORY_SNAPSHOT_ITEM_READ_LIMIT = "50000"
INVENTORY_OAUTH_RETURN_URL = "https://c0ld-clan.com/league-inv-test.html"
# HTG is Discord-bot only. Leave this blank unless you build a dedicated HTG return page.
HATCH_TRACKER_RETURN_URL = ""
# Legacy fallback only. Prefer `/htg assign channel:<channel>` after deploying
# the Discord command worker and applying migration 036.
HATCH_ALERT_CHANNEL_ID = ""
PUBLIC_CACHE_SECONDS = "5"
ALLOWED_ORIGIN = "https://c0ld-clan.com"

# HTG-enabled accounts are sharded across this every-minute cron. Their actual
# 48/day (standard) or 96/day (VIP) BIG Games refresh allowance is learned per
# Roblox account and is shared with the BIG Games site and other apps. The
# Worker starts conservatively at standard-account pace and adapts after the
# first account response. Normal inventory accounts still use the hourly
# synchronized cohort unless manually refreshed.
[triggers]
crons = ["* * * * *"]

# Required secrets:
# wrangler secret put SUPABASE_SERVICE_KEY
# wrangler secret put INGEST_ADMIN_TOKEN
# wrangler secret put BIG_GAMES_CLIENT_SECRET
# wrangler secret put HATCH_BIG_GAMES_CLIENT_SECRET
#
# Optional:
# wrangler secret put DISCORD_WEBHOOK_URL
# wrangler secret put DISCORD_BOT_TOKEN
# wrangler secret put HATCH_ALERT_WEBHOOK_URL
# wrangler secret put INVENTORY_TOKEN_ENCRYPTION_SECRET
