name = "c0ld-discord-search"
main = "discord-search-interactions-worker.js"
compatibility_date = "2026-07-14"

[vars]
CLAN_API_BASE = "https://c0ld-clan-api-worker.opal-dde.workers.dev"
# Selects which global scan cache to read. This does not restrict search
# results to c0ld members; the cache contains every player found during the
# latest global clan scan.
GLOBAL_SCAN_CLAN = "c0ld"
DISCORD_EPHEMERAL_RESPONSES = "false"
DISCORD_APPLICATION_ID = "YOUR_DISCORD_APPLICATION_ID"
# Optional. Use this while testing so the command appears in one server quickly.
DISCORD_GUILD_ID = ""
# Optional. Comma-separated Discord role IDs allowed to use /search.
# Leave blank to allow everyone who can see the command.
DISCORD_ALLOWED_ROLE_IDS = "1489032328855556096,1501632370082840576"
# Optional. Comma-separated reward cutoff ranks used by /rewards.
PLAYER_REWARD_CUTOFF_RANKS = "3,100,1000,1050,1150,6150,30000"
CLAN_REWARD_CUTOFF_RANKS = "3,10,50,100,500"

[[services]]
binding = "CLAN_API_WORKER"
service = "c0ld-clan-api-worker"

# Set these with `wrangler secret put ...` or in Cloudflare Worker settings:
# DISCORD_PUBLIC_KEY
# DISCORD_BOT_TOKEN
# REGISTER_ADMIN_TOKEN
