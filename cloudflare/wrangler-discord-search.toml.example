name = "discord-search-interactions-worker"
main = "discord-search-interactions-worker.js"
compatibility_date = "2026-07-14"

[triggers]
crons = ["*/15 * * * *"]

[vars]
CLAN_API_BASE = "https://c0ld-clan-api-worker.opal-dde.workers.dev"
LEAGUE_API_BASE = "https://yamo-league-api-worker.opal-dde.workers.dev"
SERVERS_API_BASE = "https://c0ld-servers.opal-dde.workers.dev"
# The service binding below is preferred for HTG; public Worker-to-Worker fetches
# can fail with Cloudflare 1042 on same-zone workers.dev routes.
INVENTORY_API_BASE = ""
INVENTORY_API_USE_SERVICE_BINDING = "true"
# Optional. Comma-separated image URLs for the /htg setup pages.
HTG_SETUP_STEP_IMAGE_URLS = ""
# Optional. Small image shown in the /htg setup header.
HTG_SETUP_THUMBNAIL_URL = ""
# Missing or older league snapshots are refreshed on demand by /lg info.
LEAGUE_ON_DEMAND_MAX_AGE_SECONDS = "1800"
PROFILE_DATA_BASE = "https://c0ld-clan.com/Data/players"
SITE_BASE_URL = "https://c0ld-clan.com"
# Selects which global scan cache to read. This does not restrict search
# results to c0ld members; the cache contains every player found during the
# latest global clan scan.
GLOBAL_SCAN_CLAN = "c0ld"
DISCORD_EPHEMERAL_RESPONSES = "false"
SEARCH_CHART_ENABLED = "true"
SEARCH_CHART_RESTART_MARKERS = "false"
DISCORD_APPLICATION_ID = "YOUR_DISCORD_APPLICATION_ID"
# Optional. Use this while testing so the command appears in one server quickly.
DISCORD_GUILD_ID = ""
# Guild-only /t relay command. Defaults match the c0ld server and allowed role.
T_COMMAND_GUILD_ID = "1457088639006670979"
T_COMMAND_ROLE_ID = "1489032322056589413"
# Optional. Comma-separated Discord role IDs allowed to use /search and /history.
# Leave blank to allow everyone who can see the command.
DISCORD_ALLOWED_ROLE_IDS = ""
# Optional. Comma-separated role IDs that may use /server add, /server remove,
# /tracking enable, and /tracking disable. Discord members with Administrator
# or Manage Server permission are always allowed.
SERVER_TRACKER_ADMIN_ROLE_IDS = ""
# Generates a c0ld-styled PNG for /history. Set false for the text-only fallback.
HISTORY_IMAGE_RESPONSES = "true"
# Optional. Comma-separated reward cutoff ranks used by /rewards.
PLAYER_REWARD_CUTOFF_RANKS = "3,10,100,250,500,1000,10000"
CLAN_REWARD_CUTOFF_RANKS = "1,3,10,30,50,250,500"
# Optional player rewards header. Either set the full label or just the update.
PLAYER_REWARD_LEADERBOARD_LABEL = ""
PS99_UPDATE_LABEL = ""
PS99_UPDATE_NUMBER = ""

[[services]]
binding = "CLAN_API_WORKER"
service = "c0ld-clan-api-worker"

[[services]]
binding = "LEAGUE_API_WORKER"
service = "yamo-league-api-worker"

[[services]]
binding = "SERVERS_API_WORKER"
service = "c0ld-servers"

[[services]]
binding = "INVENTORY_API_WORKER"
service = "inventory-detector-worker"

# Set these with `wrangler secret put ...` or in Cloudflare Worker settings:
# DISCORD_PUBLIC_KEY
# DISCORD_BOT_TOKEN
# REGISTER_ADMIN_TOKEN
# LEAGUE_INGEST_ADMIN_TOKEN (must match the league Worker's INGEST_ADMIN_TOKEN)
# CLAN_API_ADMIN_TOKEN (must match the clan API Worker's INGEST_ADMIN_TOKEN)
# INVENTORY_API_TOKEN (must match the inventory Worker's INGEST_ADMIN_TOKEN)
