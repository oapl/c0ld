name = "yamo-league-api-worker"
main = "yamo-league-api-worker.js"
compatibility_date = "2026-06-20"

[vars]
LEAGUE_NAME = "YAMO"
# Master safety switch. Leave false until a League run should be collectible.
# When true/auto, scheduled collection still obeys LEAGUE_RUN_START_AT and LEAGUE_RUN_END_AT.
LEAGUE_COLLECTION_ENABLED = "false"
# A new run key starts a clean collection period without deleting older league history.
LEAGUE_RUN_KEY = "tap-heroes-part-2"
LEAGUE_RUN_LABEL = "Tap Heroes Part 2"
# Optional current League start. If set, scheduled collection waits until this ISO time.
LEAGUE_RUN_START_AT = ""
# Current League end. Exposed by /api/health and /api/leagues/milestones.
LEAGUE_RUN_END_AT = "2026-07-24T16:00:00Z"
# Optional minutes after LEAGUE_RUN_END_AT during which scheduled final pulls may still run.
LEAGUE_COLLECTION_FINAL_PULL_GRACE_MINUTES = "0"
# The previous run is used only as a subtraction baseline. Its totals are never
# counted or stored as Tap Heroes Part 2 points.
LEAGUE_BASELINE_RUN_KEY = "active"
LEAGUE_NORMALIZE_POINTS_FROM_BASELINE = "true"
# Optional per-run labels. Keys are LEAGUE_RUN_KEY values.
LEAGUE_RUN_LABELS_JSON = ""
PS99_UPDATE_THEME = ""
PS99_UPDATE_LABEL = ""
PS99_UPDATE_NUMBER = ""
# Comma-separated league list used for scheduled pulls.
LEAGUE_NAMES = "NDCT,YAMO,GOATs,SNCLS,VPPPP,brrbr,3v4,SMSW,nfz,GOLD,ECTA,JIME,C0LD,COLD,2w4g,zee1,PERC,ENRQE,letto,vexly,Bol1i,CLOW,puhhh,grndd,KARAX,4ff,RAZ0,tre5,Phuny,FYNE,yuurr,zee2"
# Optional leagues forced into the main c0ld Leagues table even without a current c0ld-member match.
COLD_LEAGUE_NAMES = ""
# Optional manually tracked leagues shown in the separate Alt Leagues table.
ALT_LEAGUE_NAMES = ""
SITE_ORIGINS = "https://oapl.github.io,*"
PUBLIC_CACHE_SECONDS = "5"
# Public-response visibility only. Collection and storage always remain complete.
# Whole leagues are hidden; listed players remain visible but all their point fields are blank globally.
LEAGUE_POINTS_BLACKLIST_JSON = "{\"leagues\":[],\"players\":[\"Younes89755\",\"1856284829\",\"kessho02\"]}"
INGEST_LEAGUES = "true"
INGEST_TOP_LEAGUES = "true"
LEAGUE_INGEST_CONCURRENCY = "4"
# Configured c0ld league names refresh at :00, :15, :30, and :45.
COLD_LEAGUE_REFRESH_MINUTES = "15"
# Successful one-off /lg info lookups become a persistent general-league pool.
# Those leagues refresh at :00 and :30 without being added to LEAGUE_NAMES.
GENERAL_LEAGUE_REFRESH_ENABLED = "true"
GENERAL_LEAGUE_REFRESH_MINUTES = "30"
GENERAL_LEAGUE_REFRESH_BATCH_SIZE = "100"
GENERAL_LEAGUE_REFRESH_CONCURRENCY = "4"
# Exact-league pulls retry temporary Big Games throttling/server failures.
LEAGUE_API_RETRY_ATTEMPTS = "4"
LEAGUE_API_RETRY_BASE_MS = "1500"
# The */5 cron checks the two exact-league cadences above and updates whichever top list
# size is configured below. For league reward cutoffs that rely on Top 30,000 and
# similar points, keep this at 10000 (or higher) to keep all milestone rows fresh.
# Run POST /api/leagues/top-leagues/ingest?limit=10000&page_size=25 manually once to seed
# outside-Top-1000 ranks. After that, the cron only refreshes small neighborhoods
# around tracked leagues that are outside the Top 1000.
TOP_LEAGUES_LIMIT = "1000"
SCHEDULED_TOP_LEAGUES_LIMIT = "10000"
ALL_TOP_LEAGUES_LIMIT = "10000"
TOP_LEAGUES_PAGE_DELAY_MS = "2500"
# Manual Top 10000 seed scan pulls 25 leagues every 2.5 seconds.
ALL_TOP_LEAGUES_PAGE_DELAY_MS = "2500"
# Extended League-player reward cutoffs are simulated by collecting every
# member from the stored Top-X League list. BIG Games' direct player endpoint
# remains authoritative for ranks 1-100.
LEAGUE_PLAYER_POOL_TOP_LEAGUES = "1000"
LEAGUE_PLAYER_POOL_BATCH_SIZE = "25"
LEAGUE_PLAYER_POOL_CONCURRENCY = "4"
LEAGUE_PLAYER_DIRECT_AUTHORITATIVE_LIMIT = "100"
INGEST_TRACKED_RANK_WINDOWS = "true"
TRACKED_RANK_WINDOW_SIZE = "50"
TRACKED_RANK_WINDOW_PAGE_DELAY_MS = "2500"
TRACKED_RANK_WINDOW_EXPANSION_PAGE_DELAY_MS = "2500"
TOP_LEAGUES_STRICT_DB_ONLY = "true"
TOP_LEAGUES_LIVE_FALLBACK = "false"
TOP_LEAGUES_MAX_STALE_MINUTES = "15"
# Used by /api/leagues/c0ld-overlap. Keep batch size conservative; the matcher page can scan up to Top 10000 in chunks.
COLD_LEAGUES_BATCH_SIZE = "30"
COLD_LEAGUES_TOP_LIMIT = "10000"
COLD_LEAGUES_CONCURRENCY = "8"
# Optional JSON map/list for known c0ld members if the upstream live clan endpoint misses someone.
# COLD_MEMBER_OVERRIDES_JSON = "{\"1462748729\":\"dragonballx1412\"}"
# Preferred if the league Worker uses the same Supabase project as the clan Worker.
COLD_CLAN_CURRENT_TABLE = "c0ld_clan_current"
# Last-resort HTTP fallback. Worker-to-Worker fetches can hit Cloudflare 1042 unless
# you use a Service Binding or the global_fetch_strictly_public compatibility flag.
COLD_CLAN_CURRENT_URL = "https://c0ld-clan-api-worker.opal-dde.workers.dev/api/current"
ROBLOX_USERNAME_LOOKUPS = "true"
ROBLOX_AVATAR_LOOKUPS = "true"
# Optional Discord inactivity alerts. Store the webhook URL as a secret.
INACTIVE_ALERTS_ENABLED = "true"
# JSON map of Roblox user IDs or names to Discord user IDs/mentions.
# INACTIVE_ALERT_DISCORD_USERS = "{\"Corosion\":\"123456789012345678\"}"
# Optional. Defaults to mapped users only. Use "all" only if you want every unmapped zero-gain member posted by name.
# INACTIVE_ALERT_TARGET_USERS = "Corosion"
INACTIVE_ALERT_REQUIRE_MAPPING = "true"
INACTIVE_ALERT_EDIT_MESSAGES = "true"
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"

[triggers]
crons = ["*/5 * * * *"]

# Optional, recommended over COLD_CLAN_CURRENT_URL for Worker-to-Worker calls:
# [[services]]
# binding = "COLD_CLAN_API"
# service = "c0ld-clan-api-worker"

# Required secrets:
# wrangler secret put SUPABASE_SERVICE_KEY
# wrangler secret put INGEST_ADMIN_TOKEN
# wrangler secret put INACTIVE_ALERT_WEBHOOK_URL
