name = "yamo-league-api-worker"
main = "yamo-league-api-worker.js"
compatibility_date = "2026-06-20"

[vars]
LEAGUE_NAME = "YAMO"
# Change this when a new league run starts. Existing database rows are "legacy".
LEAGUE_RUN_KEY = "active"
# Comma-separated league list used for scheduled pulls.
LEAGUE_NAMES = "NDCT,YAMO,GOATs,SNCLS,VPPPP,brrbr,3v4,SMSW,nfz,GOLD,ECTA,JIME,COLD,2w4g,zee1,PERC,ENRQE,letto,vexly,Bol1i,CLOW,puhhh,grndd,KARAX,4ff,RAZ0,tre5,Phuny,FYNE,yuurr"
SITE_ORIGINS = "https://oapl.github.io,*"
PUBLIC_CACHE_SECONDS = "5"
INGEST_LEAGUES = "true"
INGEST_TOP_LEAGUES = "true"
TOP_LEAGUES_LIMIT = "1000"
TOP_LEAGUES_STRICT_DB_ONLY = "true"
TOP_LEAGUES_LIVE_FALLBACK = "false"
TOP_LEAGUES_MAX_STALE_MINUTES = "15"
# Used by /api/leagues/c0ld-overlap. Keep batch size conservative; the matcher page can scan up to Top 10000 in chunks.
COLD_LEAGUES_BATCH_SIZE = "30"
COLD_LEAGUES_TOP_LIMIT = "10000"
COLD_LEAGUES_CONCURRENCY = "8"
# Optional JSON map/list for known c0ld members if the upstream live clan endpoint misses someone.
# COLD_MEMBER_OVERRIDES_JSON = "{\"1462748729\":\"dragonballx1412\"}"
# Preferred if the league Worker uses the same Supabase project as the clan Worker.
COLD_CLAN_CURRENT_TABLE = "c0ld_clan_current"
# Last-resort HTTP fallback. Worker-to-Worker fetches can hit Cloudflare 1042 unless
# you use a Service Binding or the global_fetch_strictly_public compatibility flag.
COLD_CLAN_CURRENT_URL = "https://c0ld-clan-api-worker.opal-dde.workers.dev/api/current"
ROBLOX_USERNAME_LOOKUPS = "true"
ROBLOX_AVATAR_LOOKUPS = "true"
# Optional Discord inactivity alerts. Store the webhook URL as a secret.
INACTIVE_ALERTS_ENABLED = "true"
# JSON map of Roblox user IDs or names to Discord user IDs/mentions.
# INACTIVE_ALERT_DISCORD_USERS = "{\"Corosion\":\"123456789012345678\"}"
# Optional. Defaults to mapped users only. Use "all" only if you want every unmapped zero-gain member posted by name.
# INACTIVE_ALERT_TARGET_USERS = "Corosion"
INACTIVE_ALERT_REQUIRE_MAPPING = "true"
INACTIVE_ALERT_EDIT_MESSAGES = "true"
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"

[triggers]
crons = ["*/5 * * * *"]

# Optional, recommended over COLD_CLAN_CURRENT_URL for Worker-to-Worker calls:
# [[services]]
# binding = "COLD_CLAN_API"
# service = "c0ld-clan-api-worker"

# Required secrets:
# wrangler secret put SUPABASE_SERVICE_KEY
# wrangler secret put INGEST_ADMIN_TOKEN
# wrangler secret put INACTIVE_ALERT_WEBHOOK_URL
